# PostgreSQL database used by the FastAPI backend. Keep the real values in an ignored .env file.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shortsflow_ai
DATABASE_USER=shortsflow_user
DATABASE_PASSWORD=change-me

# Optional local video tools. When unset, ShortsFlow first checks PATH and then
# uses the documented Windows development fallback installed by WinGet.
FFMPEG_PATH=
FFPROBE_PATH=
# Optional local royalty-free audio. ShortsFlow never downloads or adds music automatically.
BACKGROUND_MUSIC_PATH=
